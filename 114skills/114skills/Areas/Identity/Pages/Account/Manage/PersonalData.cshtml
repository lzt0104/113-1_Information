@page
@model PersonalDataModel
@{
    ViewData["Title"] = "個人資料";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="text-center mt-5">@ViewData["Title"]</h3>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <p>您的帳戶包含您提供給我們的個人資料。本頁面允許您下載或刪除這些資料。</p>
            <p>
                <strong>刪除這些資料將會永久移除您的帳戶，且無法復原。</strong>
            </p>
            <form id="download-data" asp-page="DownloadPersonalData" method="post" class="mb-3">
                <button class="btn btn-primary w-100" type="submit">下載資料</button>
            </form>
            <p>
                <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger w-100">刪除資料</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}