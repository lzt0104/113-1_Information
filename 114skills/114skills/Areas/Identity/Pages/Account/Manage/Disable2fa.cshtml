@page
@model Disable2faModel
@{
    ViewData["Title"] = "停用雙因素驗證 (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="text-center mt-5">@ViewData["Title"]</h3>

<div class="alert alert-warning mt-4" role="alert">
    <p>
        <strong>此操作僅停用雙因素驗證 (2FA)。</strong>
    </p>
    <p>
        停用 2FA 不會更改驗證器應用程式中使用的金鑰。如果您希望更改驗證器應用程式中使用的金鑰，請 <a asp-page="./ResetAuthenticator" class="text-primary">重設您的驗證器金鑰</a>。
    </p>
</div>

<div class="text-center mt-5">
    <form method="post">
        <button class="btn btn-danger btn-lg" type="submit">停用 2FA</button>
    </form>
</div>