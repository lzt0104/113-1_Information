@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "刪除個人資料";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="text-center mt-5">@ViewData["Title"]</h3>

<div class="alert alert-warning mt-4" role="alert">
    <p>
        <strong>刪除這些資料將會永久移除您的帳戶，且無法恢復。</strong>
    </p>
</div>

<div class="container mt-5">
    <form id="delete-user" method="post" class="border rounded p-4 shadow-sm">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        @if (Model.RequirePassword)
        {
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="請輸入您的密碼。" />
                <label asp-for="Input.Password" class="form-label">密碼</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
        }
        <button class="w-100 btn btn-lg btn-danger" type="submit">刪除資料並關閉我的帳戶</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}