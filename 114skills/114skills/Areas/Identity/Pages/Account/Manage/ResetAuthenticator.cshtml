@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "重設驗證器金鑰";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="text-center mt-5">@ViewData["Title"]</h3>
<div class="alert alert-warning mt-4" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>如果您重設驗證器金鑰，您的驗證器應用程式將無法運作，直到您重新配置。</strong>
    </p>
    <p>
        此過程將禁用雙因素驗證，直到您驗證您的驗證器應用程式。
        如果您未完成驗證器應用程式的配置，可能會導致無法訪問您的帳戶。
    </p>
</div>
<div class="text-center mt-5">
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger btn-lg" type="submit">重設驗證器金鑰</button>
    </form>
</div>