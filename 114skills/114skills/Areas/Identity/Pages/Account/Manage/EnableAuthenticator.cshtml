@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "配置驗證器應用程式";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="text-center mt-5">@ViewData["Title"]</h3>
<div class="container mt-5">
    <p>請按照以下步驟來配置驗證器應用程式：</p>
    <ol class="list">
        <li>
            <p>
                下載雙因素驗證器應用程式，例如 Microsoft Authenticator 適用於
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> 和
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a>，或 Google Authenticator 適用於
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=zh-TW">Android</a> 和
                <a href="https://apps.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>。
            </p>
        </li>
        <li>
            <p>掃描 QR 碼或將此金鑰 <kbd>@Model.SharedKey</kbd> 輸入您的雙因素驗證器應用程式。空格與大小寫無關。</p>
            <div class="alert alert-info">了解如何 <a href="https://go.microsoft.com/fwlink/?Linkid=852423" class="text-primary">啟用 QR 碼生成</a>。</div>
            <div id="qrCode" class="text-center my-3"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                當您掃描 QR 碼或輸入金鑰後，您的雙因素驗證應用程式將生成一個唯一的驗證碼。
                請在下方的確認框中輸入該驗證碼。
            </p>
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8">
                    <form id="send-code" method="post" class="border rounded p-4 shadow-sm">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="請輸入驗證碼。" />
                            <label asp-for="Input.Code" class="control-label form-label">驗證碼</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">驗證</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}