@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "重新寄送電子郵件驗證";
}

<h1 class="text-center mt-5">@ViewData["Title"]</h1>
<h2 class="text-center">請輸入您的電子郵件</h2>
<hr class="mb-5" />
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <form method="post" class="border rounded p-4 shadow-sm">
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">電子郵件</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">重新寄送</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}