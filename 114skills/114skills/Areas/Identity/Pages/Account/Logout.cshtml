@page
@model LogoutModel
@{
    ViewData["Title"] = "登出";
}

<header class="container mt-5">
    <h1 class="text-center mb-4">@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="text-center">
                <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit" class="btn btn-danger">點擊此處登出</button>
                </form>
            </div>
        }
        else
        {
            <p class="text-center text-success">您已成功登出應用程式。</p>
        }
    }
</header>
