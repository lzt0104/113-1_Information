@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "恢復碼驗證";
}

<h1 class="text-center mt-5">@ViewData["Title"]</h1>
<hr class="mb-5" />
<p class="text-center text-muted">
    您已請求使用恢復碼登入。此登入方式將不會被記住，直到您在登入時提供驗證器應用程式的驗證碼，或停用雙因素驗證後再次登入。
</p>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <form method="post" class="border rounded p-4 shadow-sm">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="恢復碼" />
                    <label asp-for="Input.RecoveryCode" class="form-label">恢復碼</label>
                    <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">登入</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}