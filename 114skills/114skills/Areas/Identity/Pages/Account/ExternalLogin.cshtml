@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "註冊";
}

<h1 class="text-center mt-5">@ViewData["Title"]</h1>
<h2 id="external-login-title" class="text-center">連結您的 @Model.ProviderDisplayName 帳戶</h2>
<hr class="mb-5" />

<p id="external-login-description" class="text-info text-center">
    您已成功通過 <strong>@Model.ProviderDisplayName</strong> 驗證。
    請在下方輸入此網站的電子郵件地址，然後點擊「註冊」按鈕完成登入。
</p>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="border rounded p-4 shadow-sm">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="請輸入您的電子郵件地址。" />
                    <label asp-for="Input.Email" class="form-label">電子郵件</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">註冊</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}