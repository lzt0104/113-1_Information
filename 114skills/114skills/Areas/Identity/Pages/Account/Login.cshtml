@page
@model LoginModel

@{
    ViewData["Title"] = "登入";
}

<h1 class="text-center mt-5">@ViewData["Title"]</h1>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-6">
            <section>
                <form id="account" method="post" class="border rounded p-4 shadow-sm">
                    <h3 class="text-center mb-4">使用本地帳號登入</h3>
                    <hr />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">電子郵件</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="form-label">密碼</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">記住我</label>
                    </div>
                    <div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">登入</button>
                    </div>
                    <div class="text-center mt-3">
                        <p>
                            <a id="forgot-password" asp-page="./ForgotPassword">忘記密碼？</a>
                        </p>
                        <p>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">註冊新帳戶</a>
                        </p>
                        <p>
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">重新寄送驗證信</a>
                        </p>
                    </div>
                </form>
            </section>
        </div>
        <div class="col-lg-5 col-md-6">
            <section>
                <div class="border rounded p-4 shadow-sm mt-4 mt-md-0">
                    <h3 class="text-center mb-4">使用其他服務登入</h3>
                    <hr />
                    @{
                        if ((Model.ExternalLogins?.Count ?? 0) == 0)
                        {
                            <div>
                                <p class="text-center">
                                    尚未配置外部認證服務。參閱此 <a href="https://go.microsoft.com/fwlink/?LinkID=532715">文章</a> 了解如何配置此 ASP.NET 應用程式支援外部服務登入。
                                </p>
                            </div>
                        }
                        else
                        {
                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-flex flex-column align-items-center">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-outline-primary w-100 mb-2" name="provider" value="@provider.Name" title="使用 @provider.DisplayName 帳號登入">@provider.DisplayName</button>
                                }
                            </form>
                        }
                    }
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
