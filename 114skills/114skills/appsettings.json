{
  "Logging": {
    // 配置應用程式的日誌設定
    "LogLevel": {
      "Default": "Information",
      // 預設的日誌層級設為 "Information"，表示記錄一般的應用程式資訊、執行狀態和診斷資料

      "Microsoft.AspNetCore": "Warning"
      // ASP.NET Core 相關的日誌層級設為 "Warning"，表示只記錄警告和更高級別的日誌
    }
  },
  "AllowedHosts": "*",
  // 允許的主機名，"*" 表示允許所有主機名。用於部署時限制應用程式的訪問來源，推薦在生產環境中指定具體的主機名

  "ConnectionStrings": {
    // 資料庫連接字串配置
    "DefaultConnection": "Server=127.0.0.1;Database=114skillstest;Trusted_connection=True;TrustServerCertificate=True"
    /*
      - "Server=127.0.0.1": 指定資料庫伺服器為本機（127.0.0.1 表示本地循環地址）
      - "Database=114skillstest": 指定連接的資料庫名稱為 "114skillstest"
      - "Trusted_connection=True": 使用 Windows 驗證進行連接
      - "TrustServerCertificate=True": 信任伺服器的 SSL 憑證，避免因憑證問題而阻止連接
      - 注意：在生產環境中，應該使用安全的 SSL 憑證，避免使用 `TrustServerCertificate=True`
    */
  }
}
